{
  // Personal global markdownlint preferences.

  // Line length: disabled — one-sentence-per-line prose, tables, file trees
  // and long URLs shouldn't be forced to wrap at 80 columns.
  "MD013": false,

  // Allow documents to start with an H2 (## Title) instead of requiring an H1.
  "MD041": { "level": 2 }
}
